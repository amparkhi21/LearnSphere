# Base URL of your BACKEND API, including /api/v1.
# Local dev:   http://localhost:5000/api/v1
# Production:  set this in the Vercel dashboard (Project -> Settings -> Environment Variables),
#              e.g. https://your-backend.onrender.com/api/v1  -- then REDEPLOY (Vite bakes it in at build time).
# Never put AI provider keys here: anything with a VITE_ prefix is public in the browser.
VITE_API_BASE_URL=http://localhost:5000/api/v1
