# ==========================================
# SERVER
# ==========================================
NODE_ENV=development
PORT=5000
# Exact origin of your deployed frontend (no path). In production set this to your Vercel URL,
# e.g. https://your-app.vercel.app  (a trailing slash is tolerated).
CLIENT_URL=http://localhost:3000
# Optional: extra allowed origins, comma-separated (e.g. Vercel preview URLs)
CLIENT_URLS=

# ==========================================
# DATABASE (MongoDB Atlas Free Tier - https://www.mongodb.com/cloud/atlas)
# ==========================================
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/learning_marketplace?retryWrites=true&w=majority

# ==========================================
# AUTH / JWT
# ==========================================
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# ==========================================
# FILE STORAGE - Cloudinary Free Tier (https://cloudinary.com)
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# EMAIL - Gmail App Password / Brevo Free Tier (https://www.brevo.com)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@learningmarketplace.com

# ==========================================
# PAYMENTS - Razorpay Test Mode (https://razorpay.com) or Stripe Test Mode
# ==========================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ==========================================
# AI (quiz generation, study plans, etc.)  -- SERVER-SIDE ONLY, never put these in the frontend
# Pick ONE provider and set its key. If AI_PROVIDER is empty it is auto-detected from the keys.
# Gemini (free tier): https://aistudio.google.com/app/apikey
# Groq   (free tier): https://console.groq.com/keys
# On Render: Dashboard -> your service -> Environment -> add these variables, then redeploy.
# ==========================================
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Model IDs are optional overrides. Providers retire models over time (e.g. Groq shut down
# llama-3.1-8b-instant on 2026-08-16) - if the API reports the model is unavailable, set these.
# Defaults: gemini-3.6-flash / openai/gpt-oss-20b
GEMINI_MODEL=
GROQ_MODEL=
# Max seconds-in-ms to wait for the AI provider (default 25000)
AI_TIMEOUT_MS=25000

# ==========================================
# LIVE CLASSES - LiveKit Cloud (server-side only)
# Create API credentials in the LiveKit project console.
# Never prefix these values with VITE_ or expose the API secret to the browser.
# ==========================================
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
